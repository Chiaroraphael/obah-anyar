# Salin menjadi .env (JANGAN pernah commit .env).
# ---------- Frontend (boleh publik, dibundel ke browser) ----------
# Dari dasbor Supabase → Project Settings → API. Kosongkan untuk mode lokal (data contoh).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dari dasbor Cloudflare Turnstile → site key. Kosong = widget tidak tampil.
VITE_TURNSTILE_SITE_KEY=
# Dari Sentry → Project → Client Keys (DSN). Kosong = Sentry mati.
VITE_SENTRY_DSN=
# lite (HP) atau full
VITE_POSE_MODEL=lite

# ---------- HANYA server (Supabase Edge Functions secrets), TIDAK BOLEH di frontend ----------
# Set dengan: supabase secrets set NAMA=nilai
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
# Opsional: email pemberitahuan verifikasi sanggar (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Opsional: batasi CORS Edge Functions, pisahkan koma. Contoh: https://obah-anyar.vercel.app
ALLOWED_ORIGINS=
# Login Google (Supabase lokal membaca dari env saat `supabase start`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
